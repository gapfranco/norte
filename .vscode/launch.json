{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Norte desktop",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/norte",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Norte headless",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/norte",
      "cwd": "${workspaceFolder}",
      "args": ["-headless"],
      "buildFlags": "-tags=headless"
    }
  ]
}
